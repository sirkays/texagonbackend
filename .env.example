# ==========================================================
# Django Backend Environment Variables — EXAMPLE
# ==========================================================

# ── Multi-Tenant Brand Switching ──
# Set to 'nimet' for Nigerian Meteorological Agency or 'techxagon' for Techxagon
APP_BRAND=nimet

DJANGO_SECRET_KEY=change_me_to_a_secret_key
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=texagonbackend.settings
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,learn.techxagonacademy.com,learn.nimet.gov.ng

FRONTEND_ORIGIN=http://localhost:3000
LOCAL=1
SECURE_SSL_REDIRECT=0

# Database
POSTGRES_DB=techxagon_db_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Email (defaults to brand-specific addresses if omitted)
# DEFAULT_FROM_EMAIL=
# DOMAIN_EMAIL=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=secret
